<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the only stored data is the session, whose key cannot be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
